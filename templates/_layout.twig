<!DOCTYPE html>
<html lang="{{ craft.app.language }}">
    <head>
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta charset="utf-8">
        <title>
            {% if entry.slug == 'home' %}
                {% if entry.seoTitle %}
                    {{ entry.seoTitle }} |
                {% endif %}
                {{ currentSite.name }}
            {% else %}
                {{ entry.seoTitle ?? entry.title }} | {{ currentSite.name }}
            {% endif %}
        </title>
        <meta name="referrer" content="origin-when-cross-origin">
        <meta name="robots" content="index, follow">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
        {% set metaDescription = (entry.seoDescription ?? null) ?: (entry.summary ?? null) ?: '' %}
        {% if metaDescription %}
            <meta name="description" content="{{ metaDescription|striptags|trim }}">
        {% endif %}
        {% block openGraph %}
            <meta property="og:description" content="{{ metaDescription|striptags|trim }}">
            {% set previewImage = entry.seoPreviewImage.one() ?? brand.seoPreviewImage.one() %}
            {% if previewImage %}
                <meta property="og:image" content="{{ previewImage.getUrl({ format: 'jpg', height: 630, width: 1200, quality: 90 }) }}">
            {% endif %}
            <meta property="og:locale" content="{{ craft.app.language }}">
            <meta property="og:site_name" content="{{ currentSite.name }}">
            <meta property="og:title" content="{{ entry.seoTitle ?? entry.title }}">
            <meta property="og:type" content="website">
            <meta property="og:url" content="{{ entry.url }}">
        {% endblock %}
        <link rel="icon" href="/favicon.svg">
        <link rel="mask-icon" href="/mask-icon.svg" color="#1F336A">
        <link rel="apple-touch-icon" href="/apple-touch-icon.png">
        {% include '_partials/schema' %}
        {% block schema %}{% endblock %}
        <link href="/assets/css/style.css" rel="stylesheet" type="text/css">
        {{ craft.vite.script('src/js/index.js', false, { 'defer': true }) }}
        <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18086838077"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', 'AW-18086838077');
        </script>
    </head>
    <body>
        <input aria-label="Menu" class="menuToggle" id="menuToggle" type="checkbox">
        {% include "_partials/banner" with {
            isNavInverted: true,
            isNavTransparent: true,
        } %}
        <div class="page">
            <main class="page__main">
                {% block content %}{% endblock %}
            </main>
            {% include '_partials/footer' %}
        </div>
        <script defer src="https://unpkg.com/lucide@1.81.0/dist/umd/lucide.min.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', () => window.lucide && lucide.createIcons());
        </script>
    </body>
</html>