<IfModule mod_rewrite.c>
    RewriteEngine On

    # Route 404s to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/(favicon\.ico|apple-touch-icon.*\.png)$ [NC]
    RewriteRule (.+) index.php [L]
</IfModule>

# Browser caching
<IfModule mod_headers.c>
    # Vite build output has hashed filenames: cache for one year
    <If "%{REQUEST_URI} =~ m#^/dist/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    # Uploads, image transforms and static assets: cache for 30 days
    <ElseIf "%{REQUEST_URI} =~ m#^/(uploads|assets)/#">
        Header set Cache-Control "public, max-age=2592000"
    </ElseIf>
    <ElseIf "%{REQUEST_URI} =~ m#\.(svg|png|ico|webp)$#">
        Header set Cache-Control "public, max-age=2592000"
    </ElseIf>

    # Security headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS: start kort (1 dag); verhoog later naar max-age=31536000
    Header always set Strict-Transport-Security "max-age=86400"
</IfModule>
